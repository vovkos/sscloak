# Local client credentials -- secret, shared out of band.
# Everything under config-local/ is ignored except the checked-in example.
config-local/*
!config-local/client.example.env

# Generated at install time; never hand-edited, never committed.
config-linux/
config-windows/
sscloak-windows/

# Import links and QR codes contain credentials
shadowrocket-*.txt
shadowrocket-*.png

# Logs and temporary files
*.log
*.pid
*.tmp
tmp/

# Editor/OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Client binaries, downloaded by hand from upstream releases
bin/
